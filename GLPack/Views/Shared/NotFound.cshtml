@{
    ViewData["Title"] = "Page Not Found";
    ViewData["Breadcrumb"] = "Not Found";
}

<section class="mx-auto flex min-h-[60vh] max-w-2xl items-center justify-center px-4 py-12 text-center">
    <div>
        <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-lg bg-indigo-50 text-indigo-600 dark:bg-indigo-950/40 dark:text-indigo-200">
            <i class="fa-solid fa-magnifying-glass"></i>
        </div>
        <h1 class="mt-5 text-2xl font-semibold tracking-tight text-gray-900 dark:text-neutral-100">
            Page not found
        </h1>
        <p class="mt-2 text-sm text-gray-500 dark:text-neutral-400">
            The page may have moved, or you may not have access to this company.
        </p>
        <div class="mt-6 flex justify-center">
            <a href="/"
               class="inline-flex items-center rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500">
                <i class="fa-solid fa-house mr-2"></i>
                Back to Companies
            </a>
        </div>
    </div>
</section>
