@model GLPack.ViewModels.Companies.CompanySettingsViewModel
@{
    ViewData["Title"] = $"{Model.CompanyName} - Settings";
    ViewData["Breadcrumb"] = "Companies";
    ViewData["CompanyId"] = Model.CompanyId;
    ViewData["CompanyName"] = Model.CompanyName;
    ViewData["CompanySection"] = "Settings";
}

<section class="mx-auto max-w-4xl space-y-6">
    <div>
        <p class="text-xs uppercase tracking-wide text-gray-400 dark:text-neutral-500">
            Company Settings
        </p>
        <h1 class="text-2xl font-semibold tracking-tight">@Model.CompanyName</h1>
    </div>

    @if (TempData["CompanySettingsSuccess"] is string ok && !string.IsNullOrWhiteSpace(ok))
    {
        <div class="rounded-lg border border-emerald-300 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-900
                    dark:border-emerald-700/60 dark:bg-emerald-950/40 dark:text-emerald-100">
            @ok
        </div>
    }
    @if (TempData["CompanySettingsError"] is string error && !string.IsNullOrWhiteSpace(error))
    {
        <div class="rounded-lg border border-red-300 bg-red-50 px-4 py-3 text-sm font-medium text-red-900
                    dark:border-red-700/60 dark:bg-red-950/40 dark:text-red-100">
            @error
        </div>
    }

    <form method="post" action="/company/@Model.CompanyId/settings"
          class="rounded-lg border border-gray-200 bg-white p-5 shadow-sm dark:border-neutral-800 dark:bg-neutral-900">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="CompanyId" />
        <input type="hidden" asp-for="CompanyName" />

        <h2 class="text-base font-semibold text-gray-900 dark:text-neutral-100">
            Company Settings
        </h2>

        <div class="mt-5 space-y-5">
            <div>
                <label asp-for="Name" class="block text-sm font-medium text-gray-700 dark:text-neutral-300">
                    Company Name
                </label>
                <input asp-for="Name"
                       class="mt-1 w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm
                              focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-400
                              dark:border-neutral-700 dark:bg-neutral-950 dark:text-neutral-100" />
                <span asp-validation-for="Name" class="mt-1 block text-sm text-red-600 dark:text-red-300"></span>
            </div>

            <div class="grid gap-4 md:grid-cols-2">
                <div>
                    <label asp-for="Currency" class="block text-sm font-medium text-gray-700 dark:text-neutral-300">
                        Currency
                    </label>
                    <input asp-for="Currency"
                           maxlength="3"
                           class="mt-1 w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm uppercase
                                  focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-400
                                  dark:border-neutral-700 dark:bg-neutral-950 dark:text-neutral-100" />
                    <span asp-validation-for="Currency" class="mt-1 block text-sm text-red-600 dark:text-red-300"></span>
                </div>

                <div>
                    <label asp-for="FinancialYearEnd" class="block text-sm font-medium text-gray-700 dark:text-neutral-300">
                        Financial Year End (MM-DD)
                    </label>
                    <input asp-for="FinancialYearEnd"
                           placeholder="12-31"
                           maxlength="5"
                           class="mt-1 w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm
                                  focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-400
                                  dark:border-neutral-700 dark:bg-neutral-950 dark:text-neutral-100" />
                    <p class="mt-2 text-sm text-gray-500 dark:text-neutral-400">
                        Month and day only, for example 06-30 for June 30.
                    </p>
                    <span asp-validation-for="FinancialYearEnd" class="mt-1 block text-sm text-red-600 dark:text-red-300"></span>
                </div>
            </div>
        </div>

        <div class="mt-6 flex items-center gap-2">
            <button type="submit"
                    class="inline-flex items-center rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500">
                <i class="fa-solid fa-floppy-disk mr-2"></i>
                Save Settings
            </button>
            <a href="/company/@Model.CompanyId/dashboard"
               class="rounded-lg border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700
                      hover:bg-gray-50 dark:border-neutral-700 dark:text-neutral-100 dark:hover:bg-neutral-800">
                Cancel
            </a>
        </div>
    </form>

    <div class="rounded-lg border border-gray-200 bg-white p-5 shadow-sm dark:border-neutral-800 dark:bg-neutral-900">
        <div class="flex flex-col gap-1 sm:flex-row sm:items-start sm:justify-between">
            <div>
                <h2 class="text-base font-semibold text-gray-900 dark:text-neutral-100">
                    User Access
                </h2>
                <p class="mt-1 text-sm text-gray-500 dark:text-neutral-400">
                    Assign client users to this company. Admin users can access all companies.
                </p>
            </div>
        </div>

        <div class="mt-5 overflow-x-auto">
            <table class="min-w-full text-sm">
                <thead class="border-b border-gray-200 bg-gray-50 dark:border-neutral-800 dark:bg-neutral-900/60">
                    <tr class="text-left text-xs font-medium uppercase tracking-wide text-gray-500 dark:text-neutral-400">
                        <th class="px-4 py-3">User</th>
                        <th class="w-32 px-4 py-3">Status</th>
                        <th class="w-44 px-4 py-3">Last Login UTC</th>
                        <th class="w-28 px-4 py-3 text-right">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 dark:divide-neutral-800">
                    @if (Model.AccessUsers.Count == 0)
                    {
                        <tr>
                            <td colspan="4" class="px-4 py-6 text-center text-gray-500 dark:text-neutral-400">
                                No users assigned yet.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @for (int i = 0; i < Model.AccessUsers.Count; i++)
                        {
                            var user = Model.AccessUsers[i];
                            <tr>
                                <td class="px-4 py-3">
                                    <div class="font-medium text-gray-900 dark:text-neutral-100">@user.Email</div>
                                    <div class="text-xs text-gray-500 dark:text-neutral-400">User ID @user.UserId</div>
                                </td>
                                <td class="px-4 py-3">
                                    @if (user.IsActive)
                                    {
                                        <span class="inline-flex rounded-full bg-emerald-50 px-2 py-0.5 text-xs font-medium text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-200">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-700 dark:bg-neutral-800 dark:text-neutral-200">
                                            Inactive
                                        </span>
                                    }
                                </td>
                                <td class="px-4 py-3 text-gray-500 dark:text-neutral-400">
                                    @(user.LastLoginAtUtc?.ToString("yyyy-MM-dd HH:mm") ?? "Never")
                                </td>
                                <td class="px-4 py-3 text-right">
                                    <form method="post" action="/company/@Model.CompanyId/settings/access/remove" class="inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="UserId" value="@user.UserId" />
                                        <button type="submit"
                                                class="rounded-lg border border-red-200 px-3 py-1.5 text-sm font-medium text-red-700 hover:bg-red-50
                                                       dark:border-red-900/70 dark:text-red-300 dark:hover:bg-red-950/40">
                                            Remove
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <form method="post" action="/company/@Model.CompanyId/settings/access/add"
              class="mt-6 grid gap-3 border-t border-gray-200 pt-5 dark:border-neutral-800 sm:grid-cols-[1fr_auto] sm:items-end">
            @Html.AntiForgeryToken()
            <div>
                <label for="accessUserId" class="block text-sm font-medium text-gray-700 dark:text-neutral-300">
                    Add User
                </label>
                <select id="accessUserId"
                        name="UserId"
                        class="mt-1 w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm
                               focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-400
                               dark:border-neutral-700 dark:bg-neutral-950 dark:text-neutral-100"
                        disabled="@(Model.AvailableAccessUsers.Count == 0)">
                    @if (Model.AvailableAccessUsers.Count == 0)
                    {
                        <option value="">No client users available</option>
                    }
                    else
                    {
                        <option value="">Select a client user</option>
                        @foreach (var user in Model.AvailableAccessUsers)
                        {
                            <option value="@user.UserId">@user.Email (@(user.IsActive ? "Active" : "Inactive"))</option>
                        }
                    }
                </select>
            </div>
            <button type="submit"
                    disabled="@(Model.AvailableAccessUsers.Count == 0)"
                    class="inline-flex items-center justify-center rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500
                           disabled:cursor-not-allowed disabled:bg-gray-300 disabled:text-gray-500 dark:disabled:bg-neutral-800 dark:disabled:text-neutral-500">
                <i class="fa-solid fa-plus mr-2"></i>
                Add User
            </button>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
